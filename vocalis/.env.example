# =================================================================
# AI Meeting Assistant - Environment Configuration Example
# =================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT:
# - Do NOT commit your real .env file to version control.
# - Azure keys remain empty until explicitly deployed in their respective phases.
# =================================================================

# -----------------------------------------------------------------
# Backend Server Configuration
# -----------------------------------------------------------------
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------
# Azure OpenAI Service
# Resource: ai-meeting-assistant (East US)
# Endpoint: https://ai-meeting-assistant.openai.azure.com/
# -----------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://ai-meeting-assistant.openai.azure.com/
AZURE_OPENAI_API_KEY=

# Model Deployment Names (Configurable)
# Phase 2: Speech Transcription (Model: whisper, Version: 001)
AZURE_OPENAI_DEPLOYMENT_WHISPER=whisper

# Phase 3: Main Meeting AI (Model: gpt-4.1-mini)
# Gated: Deploy only after Phase 2 transcription is verified
AZURE_OPENAI_DEPLOYMENT_CHAT=gpt-4.1-mini

# Phase 4: Semantic Search & Context Retrieval (Model: text-embedding-3-small)
AZURE_OPENAI_DEPLOYMENT_EMBEDDING=text-embedding-3-small

# Default / Fallback deployment name
AZURE_OPENAI_DEPLOYMENT=

# -----------------------------------------------------------------
# Phase 4C: Semantic Memory Storage
# -----------------------------------------------------------------
# Storage engine type: 'sqlite' (default persistent) or 'in-memory' (ephemeral)
MEMORY_STORE_TYPE=sqlite
SQLITE_DB_PATH=data/memory.db

# -----------------------------------------------------------------
# Azure Speech Service (Optional Alternative / Native Speech Provider)
# -----------------------------------------------------------------
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# -----------------------------------------------------------------
# Frontend Configuration (Vite)
# -----------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3001
